{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run sync-sdk && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"sync-graphs": "rm -rf src/lib/server/data/graphs && mkdir -p src/lib/server/data/graphs && cp -R ../graphbuilder/output/. src/lib/server/data/graphs/",
		"sync-sdk": "mkdir -p static/sdk && cp ../sdk/dist/pzzlr-sdk.js static/sdk/pzzlr-sdk.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply pzzlr --local",
		"db:migrate:remote": "wrangler d1 migrations apply pzzlr --remote",
		"db:seed": "wrangler d1 execute pzzlr --local --file=scripts/seed.sql",
		"db:seed:remote": "wrangler d1 execute pzzlr --remote --file=scripts/seed.sql",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260826.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.126.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.1",
		"jose": "^6.2.9"
	}
}
