# Drizzle
DATABASE_URL=file:local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# OAuth providers — a provider only gets a working sign-in button once both
# of its vars below are set. Redirect/callback URI to register with each
# provider is {ORIGIN}/api/auth/callback/<provider>, e.g.
# http://localhost:5173/api/auth/callback/google for local dev.

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID is the Services ID identifier (e.g. "com.example.web"), not
# the app's bundle ID. APPLE_PRIVATE_KEY is the full contents of the .p8 file
# downloaded when you create the Sign in with Apple key (keep the
# "-----BEGIN PRIVATE KEY-----" / "-----END PRIVATE KEY-----" lines; \n for
# newlines is fine if set as a single-line env var). The client secret JWT
# itself is generated from these at server startup, so there's nothing to
# regenerate or rotate by hand.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
