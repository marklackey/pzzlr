{
	"name": "@pzzlr/sdk",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Embeddable word-ladder widget. Import this, drop a <pzzlr-ladder> tag on the page, done.",
	"main": "./dist/pzzlr-sdk.js",
